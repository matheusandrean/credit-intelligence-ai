# Credit Intelligence AI - environment configuration template
# Copy this file to `.env` and fill in values locally.
# NEVER commit the real `.env` file. It is ignored by .gitignore.

# --- LLM provider selection ---
# One of: anthropic | openai | ollama | demo
# "demo" runs the app fully without any external LLM (see docs/DEMO_MODE.md)
LLM_PROVIDER=demo

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Ollama (local models, no key required) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Paths (relative to project root; do not use absolute machine paths) ---
DATA_DIR=data
MODELS_DIR=models
KNOWLEDGE_BASE_DIR=knowledge_base

# --- RAG / vector store ---
VECTOR_STORE_DIR=data/processed/chroma_db

# --- MLflow ---
MLFLOW_TRACKING_URI=file:./mlruns
